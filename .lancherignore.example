# .lancherignore example file
#
# This file specifies patterns of files and directories that should be
# excluded when adding a template with 'lancher template add'.
#
# Usage: Place a file named '.lancherignore' in the root of your project
# before running 'lancher template add'
#
# Syntax:
# - One pattern per line
# - Lines starting with # are comments
# - Blank lines are ignored
#
# Pattern matching rules:
# - Exact match: node_modules (matches file or directory named "node_modules")
# - Trailing slash: node_modules/ (matches only directories)
# - Wildcard *: *.log (matches any file ending with .log)
# - Wildcard ?: file.? (matches file.a, file.b, etc.)
# - Recursive **: **/node_modules (matches node_modules at any depth)
# - Root pattern: /config (only matches "config" at the root, not "src/config")
#
# Examples:
# node_modules      → matches "node_modules" directory anywhere
# node_modules/     → same as above (trailing slash indicates directory)
# *.log             → matches all .log files
# /build            → only matches "build" at project root
# **/dist           → matches "dist" at any directory depth
# temp*             → matches temp, temp1, tempfile, etc.
#
# NOTE: By default, NO files or directories are ignored.
# You must explicitly list what you want to exclude.

# Common patterns you might want to ignore:

# Dependencies (trailing / is optional but clarifies these are directories)
node_modules/
vendor/

# Version control
.git
.svn
.hg

# Build outputs
dist/
build/
target/
.next/
.nuxt/
out/

# Python
__pycache__/
*.pyc
.venv/
venv/
env/
.pytest_cache/
.tox/

# Cache directories
.cache/
.parcel-cache/
.turbo/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Environment and secrets
.env
.env.local
.env.*.local
secrets.json

# Logs
*.log
logs/

# Temporary files
*.tmp
*.bak
tmp/
